# Server environment; never prefix secrets with VITE_.
NODE_ENV=production
NEXA_ORIGIN=https://cloud.example.com
HOST=127.0.0.1
PORT=5731
NEXA_DATABASE=/var/lib/nexa/nexa.sqlite
NEXA_ARTIFACTS=/var/lib/nexa/artifacts

# Paddle checkout（构建时注入前端）。VITE_PADDLE_ENV 必须显式设置，禁止默认值。
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxx
# Paddle 服务端 API Key（沙箱以 pdl_sdbx_ 开头）：仅服务端使用（webhook 验证、对账），
# 绝不进入任何 client 代码，也不要加 VITE_ 前缀。
PADDLE_API_KEY=
